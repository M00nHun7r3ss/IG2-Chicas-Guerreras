particle_system example/smokeParticle{
	billboard_type point
	particle_width 10
	particle_height 10
	quota 1000
	material example/smoke

	emitter Point{
		direction 0 0 -1
		position 0 0 0
		angle 1
		emission_rate 50
		time_to_live 10
		velocity_min 150
		velocity_max 200
		colour 0.4 0.4 0.4 0.4
	}

	affector ColourFader{
		red 0.06
		green 0.06
		blue 0.06
		alpha -0.06
	}

	affector Scaler{
		rate 20
	}
}