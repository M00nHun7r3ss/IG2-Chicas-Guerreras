vertex_program waveShaderVS glsl{
    source waveShaderVS.glsl
    default_params{
        param_named_auto modelViewProjMat worldviewproj_matrix
    }
}

fragment_program waveShaderFS glsl{
    source waveShaderFS.glsl
    default_params{
        param_named waves int 0
    }
}

material exam/waveShader
{
    technique
    {
        pass 
        {
            vertex_program_ref waveShaderVS{}
            fragment_program_ref waveShaderFS{}

            texture_unit 
            {
                texture Water02.jpg
            }
            
            texture_unit {
                texture Noise.png                
                scroll_anim 0.25 0.25
            }
        }
    }
}

material Examen/Skybox
{
    technique
    {
        pass 
        {
            lighting off
            texture_unit 
            {
                texture spaceSky.jpg
                scroll_anim 0.005 0.005
            }
        }
    }
}

material Examen/Smoke
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour
            texture_unit
            {
                texture smoke.png
                tex_address_mode clamp
            }
        }
    }
}

