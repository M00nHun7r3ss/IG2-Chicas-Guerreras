material Examen/CuerpoNave
{
    technique
    {
        pass 
        {
            diffuse 0.5 0.5 0.5
            ambient 0.1 0.2 0.3
            specular 0.8 0.8 0.8 68

            texture_unit 
            {
                texture corrosion.jpg
                colour_op modulate
                env_map spherical
            }
        }
    }
}

material Examen/BaseMotor
{
    technique
    {
        pass 
        {
            diffuse 0.5 0.5 0.5
            ambient 0.1 0.2 0.3
            specular 0.8 0.8 0.8 68

            lighting off

            texture_unit 
            {
                texture MtlPlat2.jpg
                colour_op modulate
            }
        }
    }
}

