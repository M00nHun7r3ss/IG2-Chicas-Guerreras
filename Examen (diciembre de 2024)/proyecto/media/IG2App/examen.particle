particle_system ParticleSystem/WhiteSmoke {
    billboard_type point
    particle_width 100
    particle_height 100
    quota 1000
    material Examen/Smoke

    emitter Point{
        direction 0 -1 0
        position 0 -3 0
        angle 15
        emission_rate 20
        time_to_live 6
        velocity_min 150
        velocity_max 200
        colour 0.4 0.4 0.4 0.4
        duration 100
    }

    affector ColourFader{
        red 0.06
        green 0.06
        blue 0.06
        alpha 0.06
    }

    affector LinearForce{
        force_vector 0 -100 0
        force_application add
    }

    affector Scaler{
        rate 75
        scale_range 1 1
    }
}

particle_system ParticleSystem/ColorSmoke {
    billboard_type point
    particle_width 35
    particle_height 35
    quota 500
    material Examen/Smoke

    emitter Point{
        direction 0 -1 0
        position 0 -3 0
        angle 15
        emission_rate 20
        time_to_live 6
        velocity_min 150
        velocity_max 180
        colour 0.4 0.4 0.4 0.4
        duration 100
    }

    affector ColourFader{
        red 0.06
        green 0.06
        blue 0.06
        alpha 0.06
    }

    affector LinearForce{
        force_vector 0 -100 0
        force_application add
    }

    affector ColourImage{
        image smokecolors.png
    }

    affector Scaler{
        rate 75
        scale_range 1 1
    }
}