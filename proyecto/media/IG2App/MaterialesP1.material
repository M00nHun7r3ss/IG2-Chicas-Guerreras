material FloorMaterial {
    technique{// first, preferred technique
        pass {// first pass
            diffuse 0.5 0.5 0.5
            ambient 0.1 0.2 0.3
            specular 0.8 0.8 0.8 68
            texture_unit {
                texture grass.PNG
                colour_op modulate
            }
        }
    }
}

material WallMaterial{
    technique{// first, preferred technique
        pass {// first pass
            diffuse 0.5 0.5 0.5
            ambient 0.1 0.2 0.3
            specular 0.8 0.8 0.8 68
            texture_unit {
                texture floor_diffuse.PNG
                colour_op modulate
            }
        }
    }

}