material Labyrinth/Floor 
{
    technique
    {
        pass 
        {
            diffuse 0.5 0.5 0.5
            ambient 0.1 0.2 0.3
            specular 0.8 0.8 0.8 68

            texture_unit 
            {
                texture grass.PNG
                colour_op modulate
            }

            texture_unit {
                texture lightMap.jpg
                colour_op modulate
            }
        }
    }
}

material Labyrinth/Wall
{
    technique
    {
        pass 
        {
            diffuse 0.5 0.5 0.5
            ambient 0.1 0.2 0.3
            specular 0.8 0.8 0.8 68

            texture_unit 
            {
                texture floor_diffuse.PNG
                colour_op modulate
            }
        }
    }

}

material Labyrinth/Skybox
{
    technique
    {
        pass 
        {
            lighting off
            texture_unit 
            {
                texture spaceSky.jpg
            }

            texture_unit {
                texture lightMap.jpg
            }
        }
    }
}