particle_system ParticleSystem/smokeParticle{
	billboard_type point
	particle_width 35
	particle_height 35
	quota 20
	material Smoke/body
	emitter Point{
		direction 0 1 0
		position 0 0 0
		angle 180
		emission_rate 5
		time_to_live 5
		velocity_min 50
		velocity_max 80
		colour 0.4 0.4 0.4 0.4
		duration 2
	}
	affector ColourFader{
		red 0.06
		green 0.06
		blue 0.06
		alpha 0.06
	}
  	affector LinearForce
    	{
        	force_vector 0 100 0   
    	}

	affector ColourImage{
 		image smokecolors.png
	}
}